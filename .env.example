# =============================================================================
# Campaign Manager - Environment Configuration Template
# =============================================================================
# Copy this file to .env or .env.local and configure your actual values.
# NEVER commit real production secrets, API keys, or private passwords to Git.

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
# Standard connection string for PostgreSQL / Prisma ORM:
# Local Docker instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_manager?schema=public"
# If using Supabase or connection poolers (PgBouncer), provide direct connection for migrations:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/campaign_manager?schema=public"


# -----------------------------------------------------------------------------
# In-Memory Cache, Queue & Distributed Rate Limiting (Redis 7)
# -----------------------------------------------------------------------------
# Connection URL for Redis (used by BullMQ job queue and atomic rate limiting):
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# External Telephony Integration (Sarvam AI Instant Outbound Voice API)
# -----------------------------------------------------------------------------
# Official Sarvam base URL (defaults to https://apps.sarvam.ai):
SARVAM_API_BASE_URL="https://apps.sarvam.ai"

# Your Sarvam AI API Key (obtained from Sarvam dashboard):
# Set to empty or placeholder to run in safe local MOCK simulation mode.
SARVAM_API_KEY="your-sarvam-api-key-here"

# Explicit Mock Mode toggle:
# - "true": Simulates realistic call dispatches without calling real carrier phone lines.
# - "false": Dispatches live phone calls to carrier network (requires valid API key & telephony trunk).
SARVAM_MOCK_MODE="true"

# -----------------------------------------------------------------------------
# Webhook Security
# -----------------------------------------------------------------------------
# Shared secret token for authenticating incoming call status webhooks.
# In production, this MUST be set to a strong random token.
# Pass this only via the `x-webhook-secret` header or `Authorization: Bearer`. Query strings are rejected.
WEBHOOK_SECRET="local-dev-webhook-secret"

# -----------------------------------------------------------------------------
# Application & Deployment Settings
# -----------------------------------------------------------------------------
# Publicly accessible URL for your application:
# (Used to construct webhook callbacks passed to Sarvam)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"
PORT=3000

# -----------------------------------------------------------------------------
# Development Demo Provisioning & Credentials
# -----------------------------------------------------------------------------
# Enable quick-fill demo buttons on /login page (strictly disabled in production):
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# Allow running `npm run db:seed` in production (default false):
ALLOW_PRODUCTION_SEED="false"

# Development Superadmin Account:
SUPERADMIN_EMAIL="voiceagent@yopmail.com"
SUPERADMIN_PASSWORD="12345678"

# Development Organisation A (Acme Corp) Owner:
COMPANY_OWNER_EMAIL="admin@acme.com"
COMPANY_OWNER_PASSWORD="12345678"

# Development Organisation B (Beta Health) Owner:
ORG_B_OWNER_EMAIL="admin@betahealth.com"
ORG_B_OWNER_PASSWORD="12345678"
