# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_manager?schema=public"

# Redis Configuration (BullMQ job queues, caching, rate limiting)
REDIS_URL="redis://localhost:6379"

# External Voice API (Sarvam AI)
# Placeholder for Sarvam API key - do not commit real secrets
SARVAM_API_KEY="your-sarvam-api-key-here"
SARVAM_API_BASE_URL="https://api.sarvam.ai"

# Webhook Security
# Shared secret for validating incoming call status webhooks
WEBHOOK_SECRET="your-webhook-secret-token"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

